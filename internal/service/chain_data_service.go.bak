type ValidatorEventsOrderBy string
type ValidatorEventFilter map[string]any
type PowerEventFilter map[string]any
type PowerEventsOrderBy string

// historical data
func (service *chainDataService) GetValidatorEvents(ctx context.Context, params *model.ValidatorEventQuery) (*utils.Paginator, error) {
	page := utils.NewPaginator(params.Current, params.Size)
	order := "desc"
	if params.Order == "asc" {
		order = "asc"
	}
	sort := "block_height"
	if params.Sort != "" {
		sort = params.Sort
	}

	orderBy := strings.ToUpper(fmt.Sprintf("%s_%s", sort, order))
	client := graphql.NewClient(config.GetConfig().Endpoint.Graph, nil)
	var query struct {
		ValidatorEvents struct {
			Nodes []struct {
				ID                 graphql.ID
				Validator          graphql.String
				TxHash             graphql.String
				BlockHeight        graphql.Int
				EventType          graphql.String
				PrevCommissionRate graphql.Float
				CommissionRate     graphql.Float
				Timestamp          graphql.String
			}
			PageInfo struct {
				HasNextPage graphql.Boolean
			}
		} `graphql:"validatorEvents(orderBy: $orderBy, offset: $offset, first: $limit, filter: $filter)"`
	}
	var blockHeight = map[string]any{
		"greaterThan": graphql.Int(0),
	}
	var filter ValidatorEventFilter = map[string]any{
		"blockHeight": blockHeight,
	}
	if params.Validator != "" {
		filter["validator"] = map[string]any{
			"equalTo": params.Validator,
		}
	}
	variables := map[string]interface{}{
		"orderBy": []ValidatorEventsOrderBy{ValidatorEventsOrderBy(orderBy)},
		"offset":  graphql.Int(page.Offset()),
		"limit":   graphql.Int(page.Limit()),
		"filter":  filter,
	}
	err := client.Query(ctx, &query, variables)
	if err != nil {
		return nil, err
	}
	page.SetHasMore(bool(query.ValidatorEvents.PageInfo.HasNextPage))
	events := make([]model.ValidatorEvent, len(query.ValidatorEvents.Nodes))
	now := time.Now().UnixMilli()
	for i, node := range query.ValidatorEvents.Nodes {
		timestamp, _ := strconv.ParseInt(string(node.Timestamp), 10, 64)
		age := now - timestamp
		events[i] = model.ValidatorEvent{
			ID:                 fmt.Sprintf("%s", node.ID),
			Validator:          string(node.Validator),
			TxHash:             string(node.TxHash),
			BlockHeight:        int(node.BlockHeight),
			EventType:          string(node.EventType),
			PrevCommissionRate: float64(node.PrevCommissionRate),
			CommissionRate:     float64(node.CommissionRate),
			Timestamp:          timestamp,
			Age:                age,
		}
	}
	page.SetList(events)
	return page, nil
}

// historical data
func (service *chainDataService) GetPowerEvents(ctx context.Context, params *model.PowerEventQuery) (*utils.Paginator, error) {
	page := utils.NewPaginator(params.Current, params.Size)
	order := "desc"
	if params.Order == "asc" {
		order = "asc"
	}
	sort := "block_height"
	if params.Sort != "" {
		sort = params.Sort
	}

	orderBy := strings.ToUpper(fmt.Sprintf("%s_%s", sort, order))
	fmt.Println(orderBy)
	client := graphql.NewClient(config.GetConfig().Endpoint.Graph, nil)
	var query struct {
		PowerEvents struct {
			Nodes []struct {
				ID          graphql.ID
				BlockHeight graphql.Int
				TxHash      graphql.String
				Validator   graphql.String
				Delegator   graphql.String
				Amount      graphql.Float
				EventType   graphql.String
				Timestamp   graphql.String
			}
			PageInfo struct {
				HasNextPage graphql.Boolean
			}
		} `graphql:"powerEvents(orderBy: $orderBy, offset: $offset, first: $limit, filter: $filter)"`
	}
	var blockHeight = map[string]any{
		"greaterThan": graphql.Int(0),
	}
	var filter PowerEventFilter = map[string]any{
		"blockHeight": blockHeight,
	}
	if params.Validator != "" {
		filter["validator"] = map[string]any{
			"equalTo": params.Validator,
		}
	}
	if params.Delegator != "" {
		filter["delegator"] = map[string]any{
			"equalTo": params.Delegator,
		}
	}
	variables := map[string]interface{}{
		"orderBy": []PowerEventsOrderBy{PowerEventsOrderBy(orderBy)},
		"offset":  graphql.Int(page.Offset()),
		"limit":   graphql.Int(page.Limit()),
		"filter":  filter,
	}
	err := client.Query(ctx, &query, variables)
	if err != nil {
		return nil, err
	}
	page.SetHasMore(bool(query.PowerEvents.PageInfo.HasNextPage))
	events := make([]model.PowerEvent, len(query.PowerEvents.Nodes))
	now := time.Now().UnixMilli()
	for i, node := range query.PowerEvents.Nodes {
		timestamp, _ := strconv.ParseInt(string(node.Timestamp), 10, 64)
		age := now - int64(timestamp)
		events[i] = model.PowerEvent{
			ID:          fmt.Sprintf("%s", node.ID),
			BlockHeight: int(node.BlockHeight),
			TxHash:      string(node.TxHash),
			Validator:   string(node.Validator),
			Delegator:   string(node.Delegator),
			Amount:      float64(node.Amount),
			EventType:   string(node.EventType),
			Timestamp:   timestamp,
			Age:         age,
		}
	}
	page.SetList(events)
	return page, nil
}
